[Unit]
Description=zigbee2mqtt
After=network.target mosquitto.service
# The timer checks that the Zigbee module still answers, see zigbee_module_guard.py
Wants=mosquitto.service zigbee2mqtt-watchdog.timer

[Service]
# Resolves the serial port from the slot picked in the web interface, so a module declared
# after the install is picked up on the next start. Never fails the service
ExecStartPre=/usr/lib/zigbee2mqtt/setup-z2m-config.sh
# Resets the Zigbee module of the slot if it does not answer. "-": never fails the service
ExecStartPre=-/usr/bin/python3 /usr/lib/zigbee2mqtt/zigbee_module_guard.py recover
ExecStart=/usr/bin/npm start
SyslogIdentifier=zigbee2mqtt
WorkingDirectory=/mnt/data/root/zigbee2mqtt
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=90
# Four starts with a silent Zigbee module are 161 s apart and have to fit in: then the service
# fails and the watchdog timer makes the further attempts, one in five minutes
StartLimitInterval=900
StartLimitBurst=3
User=root

[Install]
WantedBy=multi-user.target
